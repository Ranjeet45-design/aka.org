# Copy to .env.local (local) and add the same names in Vercel > Project > Settings > Environment Variables.
# NEVER commit real values.

# --- Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin) ---
# Public site key (safe in the browser)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key (server only)
RECAPTCHA_SECRET_KEY=
# Minimum v3 score to accept (0.0-1.0). Default 0.5
RECAPTCHA_MIN_SCORE=0.5

# --- SMTP (Google Workspace, Microsoft 365, Brevo, SendGrid SMTP, Amazon SES...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Sender shown on the email; must be allowed by your SMTP provider, e.g. "AKA Website <info@aka.org.au>"
MAIL_FROM=
# Where submissions are delivered
CONTACT_TO=info@aka.org.au
